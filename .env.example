# Hermes Agent WhatsApp bridge — leave blank to run in demo mode
# Local: http://127.0.0.1:3000 after `npm run hermes`
# Vercel: public HTTPS URL of the Railway Hermes service (127.0.0.1 will not work)
HERMES_WHATSAPP_URL=http://127.0.0.1:3000
HERMES_BRIDGE_TOKEN=
HERMES_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_NAME=Northside Market
